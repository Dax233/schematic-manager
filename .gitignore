# ---- Node / 前端 ----
node_modules/
dist/
dist-ssr/
*.local
.vite/
*.tsbuildinfo

# ---- Rust / Tauri ----
target/
src-tauri/target/
src-tauri/gen/

# ---- 构建产物 ----
build/
out/
*.exe
*.msi
*.dmg
*.AppImage
*.deb
*.rpm
*.snap

# ---- 发布流程的中间产物（由 .github/workflows/release.yml 生成）----
# 本地演练这两个脚本时会在仓库根目录留下它们，误入库后
# 会与工作流自己生成的文件冲突
assets.json
release-notes.md
release-assets/
artifacts/
dist-artifacts/

# ---- 大体积数据（不进仓库）----
cache/
data/versions/
*.jar
*.zip

# ---- 编辑器 / 系统 ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# ---- 运行期数据 ----
packs/
backups/
diag.log

# 本地构建日志（演练 tauri build 时产生）
build_out.log

# 启动失败时在程序目录旁生成的诊断日志
启动失败.log

# 离线验证脚本把 TEMP 指到仓库内的 _temp（本机拒绝写系统临时目录），
# 其中是测试运行产生的临时文件，不应入库。
_temp/


# Python 编译产物：产生自 legacy-cpp/tools 下的脚本，
# 属于生成物而非参考源码。
__pycache__/
*.pyc

.ref/
.dsh/

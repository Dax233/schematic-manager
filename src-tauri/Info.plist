<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 本文件与 tauri.conf.json 同级，打包 macOS 版本时会与 Tauri 生成的
	     Info.plist 合并，且以本文件为准。

	     productName 是 ASCII 的 schematic-manager（.app 目录名与 dmg 文件名
	     都由它派生），而 Tauri 会把 CFBundleDisplayName 也写成 productName。
	     Finder 里显示的是 CFBundleDisplayName，所以这里覆盖回中文；
	     CFBundleName（菜单栏里的名字）由 bundle.macOS.bundleName 指定。 -->
	<key>CFBundleDisplayName</key>
	<string>投影文件管理器</string>
</dict>
</plist>

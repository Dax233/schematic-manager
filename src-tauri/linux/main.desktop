# 桌面项模板。Tauri 默认把 Name 写成 productName，而 productName 已改成
# ASCII 的 schematic-manager——那是包名与安装目录要用的名字。桌面项、应用
# 菜单里要显示给用户的仍是中文，所以这里换掉 Name，其余键与默认模板一致。
#
# 模板变量由打包器提供：categories、comment、exec、icon、mime_type。
[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}}
StartupWMClass={{exec}}
Icon={{icon}}
Name=投影文件管理器
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
